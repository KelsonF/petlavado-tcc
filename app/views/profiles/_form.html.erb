<%= form_with(model: profile, local: true, class: "space-y-6") do |form| %>
  <% if profile.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded relative" role="alert">
      <strong class="font-bold"><%= pluralize(profile.errors.count, "error") %> prohibited this profile from being saved:</strong>
      <ul class="mt-2 list-disc list-inside">
        <% profile.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :avatar, class: "block text-sm font-medium text-fg mb-2" %>
    <%= form.file_field :avatar, class: "block w-full text-sm text-fg-muted file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100" %>
  </div>

  <div>
    <%= form.label :display_name, class: "block text-sm font-medium text-fg mb-2" %>
    <%= form.text_field :display_name, class: "w-full px-3 py-2 bg-surface border border-border rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-fg placeholder-fg-muted" %>
  </div>

  <div>
    <%= form.label :bio, class: "block text-sm font-medium text-fg mb-2" %>
    <%= form.text_area :bio, rows: 4, class: "w-full px-3 py-2 bg-surface border border-border rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-fg placeholder-fg-muted" %>
    <p class="mt-1 text-sm text-fg-muted">Write a short bio about yourself.</p>
  </div>

  <div class="flex justify-end gap-4">
    <%= link_to "Cancel", profile_path(profile), class: "px-4 py-2 border border-border rounded-lg text-fg hover:bg-surface-elevated transition" %>
    <%= form.submit "Save Profile", class: "px-4 py-2 bg-primary-500 text-white font-bold rounded-lg hover:bg-primary-600 transition cursor-pointer" %>
  </div>
<% end %>
