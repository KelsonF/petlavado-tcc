<div class="bg-surface-muted rounded-lg p-4 border border-border mb-4">
  <h4 class="text-lg font-semibold text-fg mb-2 font-heading">
    Chat com <%= chat_other_party_name(@chat, @current_user) %>
  </h4>
  <div id="messages">
    <%= turbo_stream_from @chat, "messages" %>
    <%= render @chat.messages, user: @current_user  %>
  </div>
  <%= render partial: "messages/form", locals: { chat: @chat } %>
</div>
