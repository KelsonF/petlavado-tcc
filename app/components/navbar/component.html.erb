<nav class="bg-cyan-800 text-white py-4 shadow">
  <div class="px-7 mx-auto flex justify-between items-center">
    <%= link_to "PETLAVADO",
                products_path,
                class: "font-heading font-bold text-xl hover:text-cyan-200 transition-colors duration-200"
              %>

    <!-- Desktop menu -->
    <div class="hidden md:flex gap-3 items-center">
      <% if user_signed_in? %>
        <% if current_user.store.nil? %>
          <%= link_to "Create Store", new_store_path, class: "btn-primary" %>
        <% elsif current_user.store.present? %>
          <%= link_to "My Store", current_user.store, class: "btn-accent" %>
        <% end %>
        <%= render Button::Component.new(
          label: "Log out",
          url: destroy_user_session_path,
          method: :delete,
          class: "bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-4 rounded-lg transition-colors duration-200"
        ) %>
      <% end %>
    </div>
  </div>
</nav>
