<div class="bg-surface-muted rounded-lg p-4 border border-border mb-4">
  <h4 class="text-lg font-semibold text-fg mb-2 font-heading">Chat com <%= @chat.store.name %></h4>
  <%= turbo_frame_tag dom_id(@chat, "messages") do %>
    <div id="messages">
      <%= render Message::Component.with_collection(@chat.messages) %>
    </div>
  <% end %>
  <%= turbo_frame_tag dom_id(@chat, "new_message") do %>
    <%= form_with model: [@chat, Message.new], url: chat_messages_path(@chat), local: false do |f| %>
      <div class="flex gap-2 mt-2">
        <%= f.text_field :content, placeholder: "Digite sua mensagem...", class: "w-full px-3 py-2 border border-border rounded focus:outline-none focus:ring-1 focus:ring-primary-400 bg-surface-elevated text-fg placeholder:text-fg-soft" %>
        <%= f.submit "Enviar", class: "bg-primary-400 text-white font-bold px-4 rounded hover:bg-secondary-400 transition" %>
      </div>
    <% end %>
  <% end %>
</div>
