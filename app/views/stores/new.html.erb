<div class="h-full flex items-center justify-center bg-surface">
  <div class="w-full max-w-md bg-surface-elevated rounded-2xl shadow-xl p-10 border border-border">
    <div class="mb-8 text-center">
      <div class="flex justify-center mb-4">
        <span class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary-400 shadow-lg">
          <span class="text-4xl text-white">🏪</span>
        </span>
      </div>
      <h2 class="text-3xl font-bold text-fg font-heading mb-2">Bem-vindo!</h2>
      <p class="text-fg-muted text-base">Vamos criar sua loja e começar a vender para o mundo pet.</p>
    </div>
    <%= form_for(@store) do |f| %>
      <% if @store.errors.any? %>
        <div class="mb-4 text-danger-400 bg-danger-100 border border-danger-400 rounded p-3">
          <ul class="list-disc list-inside">
            <% @store.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="mb-4">
        <%= f.label :name, "Nome da Loja", class: "block text-fg font-semibold mb-2" %>
        <%= f.text_field :name, autofocus: true, placeholder: "Ex: Pet Feliz", class: "w-full px-3 py-2 border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-400 bg-surface-elevated text-fg placeholder:text-fg-soft transition" %>
      </div>
      <div class="mb-4">
        <%= f.label :description, "Descrição", class: "block text-fg font-semibold mb-2" %>
        <%= f.text_area :description, placeholder: "Conte um pouco sobre sua loja...", rows: 3, class: "w-full px-3 py-2 border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-400 bg-surface-elevated text-fg placeholder:text-fg-soft transition" %>
      </div>
      <div>
        <%= f.submit "Criar Loja", class: "w-full bg-primary-400 text-white font-bold py-3 px-4 rounded-lg hover:bg-secondary-400 transition" %>
      </div>
    <% end %>
    <div class="mt-6 text-center">
      <%= link_to "← Voltar", root_path, class: "text-accent-300 hover:underline text-sm" %>
    </div>
  </div>
</div>
