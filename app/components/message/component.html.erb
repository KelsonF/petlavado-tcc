<div class="mb-2 flex <%= @message.user == current_user ? 'justify-end' : 'justify-start' %>">
  <div class="px-4 py-2 rounded-lg <%= @message.user == current_user ? 'bg-primary-400 text-white' : 'bg-surface-elevated text-fg' %>">
    <span class="text-sm"><%= @message.content %></span>
    <span class="block text-xs text-fg-soft mt-1"><%= l(@message.created_at, format: :short) %></span>
  </div>
</div>