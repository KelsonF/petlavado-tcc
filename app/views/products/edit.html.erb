<div class="h-full flex items-center justify-center bg-surface">
  <div class="w-full max-w-md bg-surface-elevated rounded-lg shadow-md p-8 border border-border">
    <h2 class="text-2xl font-bold mb-6 text-center text-fg font-heading">Editar Produto</h2>
    <%= form_for([@store, @product]) do |f| %>
      <% if @product.errors.any? %>
        <div class="mb-4 text-danger-400">
          <ul>
            <% @product.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="mb-4">
        <%= f.label :name, "Nome", class: "block text-fg font-semibold mb-2" %>
        <%= f.text_field :name, autofocus: true, class: "w-full px-3 py-2 border border-border rounded focus:outline-none focus:ring-1 focus:ring-ring bg-surface-elevated text-fg placeholder:text-fg-soft" %>
      </div>
      <div class="mb-4">
        <%= f.label :description, "Descrição", class: "block text-fg font-semibold mb-2" %>
        <%= f.text_area :description, rows: 4, class: "w-full px-3 py-2 border border-border rounded focus:outline-none focus:ring-1 focus:ring-ring bg-surface-elevated text-fg placeholder:text-fg-soft" %>
      </div>
      <div class="mb-4">
        <%= f.label :image, "Imagem do Produto", class: "block text-fg font-semibold mb-2" %>
        <% if @product.image.attached? %>
          <div class="mb-2">
            <%= image_tag @product.image, class: "w-32 h-32 object-cover rounded border border-border" %>
            <p class="text-sm text-secondary-300">Imagem atual</p>
          </div>
        <% end %>
        <%= f.file_field :image, accept: "image/*", class: "w-full px-3 py-2 border border-border rounded focus:outline-none focus:ring-1 focus:ring-ring bg-surface-elevated text-fg" %>
        <p class="text-sm text-secondary-300 mt-1">Formatos aceitos: JPEG, PNG, GIF (máx. 5MB)</p>
      </div>
      <div class="mb-6">
        <%= f.label :price, "Preço (R$)", class: "block text-fg font-semibold mb-2" %>
        <%= f.number_field :price, step: 0.01, min: 0, class: "w-full px-3 py-2 border border-border rounded focus:outline-none focus:ring-1 focus:ring-ring bg-surface-elevated text-fg placeholder:text-fg-soft" %>
      </div>
      <div>
        <%= f.submit "Atualizar Produto", class: "w-full bg-primary-400 text-white font-bold py-2 px-4 rounded hover:bg-secondary-400 transition" %>
      </div>
    <% end %>
    <div class="mt-4 text-center">
      <%= link_to "Voltar", [@store, @product], class: "text-accent-300 hover:underline" %>
    </div>
  </div>
</div>