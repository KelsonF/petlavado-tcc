<div class="h-full bg-surface p-6">
  <div class="max-w-6xl mx-auto">
    <!-- Store Header -->
    <div class="bg-surface-elevated rounded-lg shadow-md p-8 mb-6 border border-border">
      <div class="flex justify-between items-start mb-6">
        <div>
          <h1 class="text-3xl font-bold text-fg mb-2 font-heading"><%= @store.name %></h1>
          <p class="text-fg-muted text-lg">Painel Administrativo</p>
        </div>
        <% if @store.owner == current_user %>
          <div class="flex gap-2">
            <%= link_to "Editar Loja", edit_store_path(@store), class: "px-4 py-2 rounded font-semibold bg-accent-400 text-white hover:bg-primary-400 transition" %>
            <%= link_to "Excluir Loja", store_path(@store), method: :delete,
                                                            data: { confirm: "Tem certeza que deseja excluir esta loja?" },
                                                            class: "px-4 py-2 rounded font-semibold bg-danger-400 text-white hover:bg-danger-300 transition" %>
          </div>
        <% end %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-lg font-semibold text-fg mb-2 font-heading">Descrição</h3>
          <p class="text-fg-soft bg-surface-muted p-4 rounded"><%= @store.description %></p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-fg mb-2 font-heading">Contato</h3>
          <p class="text-fg-soft bg-surface-muted p-4 rounded"><%= @store.address.full_address %></p>
        </div>
      </div>
    </div>

    <!-- Products Section -->
    <div class="bg-surface-elevated rounded-lg shadow-md p-8 border border-border">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-fg font-heading">Produtos</h2>
        <% if @store.owner == current_user %>
          <%= link_to "Novo Produto", new_store_product_path(@store), class: "px-4 py-2 rounded font-semibold bg-accent-400 text-white hover:bg-primary-400 transition" %>
        <% end %>
      </div>

      <% if @store.products.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          <% @store.products.each do |product| %>
            <%= render "products/admin_product_card", product: product, store: @store %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-12">
          <div class="text-6xl text-secondary-300 mb-4">📦</div>
          <h3 class="text-xl font-semibold text-fg mb-2 font-heading">Nenhum produto cadastrado</h3>
          <p class="text-secondary-300 mb-6">Comece adicionando seu primeiro produto à loja.</p>
        </div>
      <% end %>
    </div>

    <!-- Chats Section for Store Owner -->
    <% if @store.owner == current_user %>
      <div class="bg-surface-elevated rounded-lg shadow-md p-8 border border-border mt-8">
        <h2 class="text-2xl font-bold text-fg font-heading mb-6">Meus Chats</h2>
        <% chats = Chat.where(store: @store).includes(:user).order(updated_at: :desc) %>
        <% if chats.any? %>
          <div class="divide-y divide-border">
            <% chats.each do |chat| %>
              <div class="py-4 flex justify-between items-center">
                <div>
                  <span class="font-semibold text-fg">Cliente:</span>
                  <span class="text-accent-400"><%= chat.user.email %></span>
                  <span class="ml-4 text-fg-soft text-sm">Última mensagem: <%= l(chat.updated_at, format: :short) %></span>
                </div>
                <%= link_to "Abrir Chat", chat_path(chat), class: "px-4 py-2 rounded font-semibold bg-primary-400 text-white hover:bg-secondary-400 transition" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8 text-fg-soft">
            Nenhum chat iniciado ainda.
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
