<div class="h-full bg-surface p-6">
  <div class="max-w-4xl mx-auto">
    <%= render partial: "products/product_details", locals: { product: @product, store: @store } %>

    <!-- Comments Section -->
    <div class="mt-10">
      <h3 class="text-xl font-bold mb-4">Comentários</h3>
      <%= turbo_frame_tag "comments" do %>
        <% @product.comments.each do |comment| %>
          <div class="mb-4 p-4 bg-surface-elevated rounded border border-border">
            <div class="text-sm text-fg-soft mb-2">
              <strong><%= comment.user.email %></strong>
              <span class="ml-2"><%= l(comment.created_at, format: :short) %></span>
            </div>
            <div class="text-fg"><%= simple_format(comment.content) %></div>
          </div>
        <% end %>
      <% end %>

      <% if user_signed_in? %>
        <%= turbo_frame_tag "new_comment" do %>
          <%= form_with model: [@product, Comment.new], local: false do |f| %>
            <div class="mb-4">
              <%= f.text_area :content, rows: 3, placeholder: "Deixe seu comentário...", class: "w-full px-3 py-2 border border-border rounded" %>
            </div>
            <%= f.submit "Comentar", class: "bg-primary-400 text-white font-bold px-4 py-2 rounded mb-5" %>
          <% end %>
        <% end %>
      <% else %>
        <p class="text-fg-soft">Faça login para comentar.</p>
      <% end %>
    </div>
  </div>
</div>