<div class="max-w-4xl mx-auto py-8 px-4">
  <!-- Profile Info Section -->
  <div class="flex flex-col md:flex-row items-center md:items-start gap-8 mb-12">
    <!-- Avatar -->
    <div class="flex-shrink-0">
      <div class="w-32 h-32 md:w-40 md:h-40 rounded-full bg-surface-elevated border-2 border-border flex items-center justify-center overflow-hidden">
        <% if @profile.avatar.attached? %>
          <%= image_tag @profile.avatar, class: "w-full h-full object-cover" %>
        <% else %>
          <span class="text-4xl text-fg-muted font-bold"><%= @profile.display_name.present? ? @profile.display_name.first.upcase : @profile.user.email.first.upcase %></span>
        <% end %>
      </div>
    </div>

    <!-- Info -->
    <div class="flex-grow text-center md:text-left space-y-4">
      <div class="flex flex-col md:flex-row items-center gap-4">
        <h1 class="text-2xl font-heading font-bold"><%= @profile.display_name.presence || @profile.user.email.split('@').first %></h1>
        
        <% if current_user == @profile.user %>
          <%= link_to "Edit Profile", edit_profile_path(@profile), class: "px-4 py-1.5 bg-surface-elevated border border-border rounded font-medium text-sm hover:bg-neutral-700 transition" %>
        <% end %>
      </div>

      <div class="flex justify-center md:justify-start gap-8 text-fg">
        <div class="text-center md:text-left">
          <span class="font-bold block md:inline"><%= @profile.posts.count %></span> posts
        </div>
        <!-- Add followers/following here later if needed -->
      </div>

      <div class="text-fg-soft max-w-md">
        <%= simple_format(@profile.bio) %>
      </div>
    </div>
  </div>

  <!-- Posts Grid -->
  <div class="border-t border-border pt-8">
    <% if @profile.posts.any? %>
      <div class="grid grid-cols-3 gap-1 md:gap-4">
        <%= render @profile.posts %>
      </div>
    <% else %>
      <div class="text-center py-12 text-fg-muted">
        <div class="mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-fg">No Posts Yet</h3>
      </div>
    <% end %>
  </div>
</div>
