<div class="flex items-center gap-3 text-sm text-fg-soft">
  <span class="flex items-center gap-1">
    <span class="font-medium text-white/90">Likes:</span>
    <span class="font-bold text-emerald-400"><%= post.reactions.like.count %></span>
  </span>
  <span class="flex items-center gap-1">
    <span class="font-medium text-white/90">Dislikes:</span>
    <span class="font-bold text-rose-400"><%= post.reactions.dislike.count %></span>
  </span>
</div>
