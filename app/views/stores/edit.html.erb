<div class="h-full flex items-center justify-center bg-surface">
  <div class="w-full max-w-md bg-surface-elevated rounded-lg shadow-md p-8 border border-border">
    <h2 class="text-2xl font-bold mb-6 text-center text-fg font-heading">Editar Loja</h2>
    <%= form_for(@store) do |f| %>
      <% if @store.errors.any? %>
        <div class="mb-4 text-danger-400">
          <ul>
            <% @store.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="mb-4">
        <%= f.label :name, class: "block text-fg font-semibold mb-2" %>
        <%= f.text_field :name, autofocus: true, class: "w-full px-3 py-2 border border-border rounded focus:outline-none focus:ring-1 focus:ring-ring bg-surface-elevated text-fg placeholder:text-fg-soft" %>
      </div>
      <div class="mb-4">
        <%= f.label :description, class: "block text-fg font-semibold mb-2" %>
        <%= f.text_area :description, class: "w-full px-3 py-2 border border-border rounded focus:outline-none focus:ring-1 focus:ring-ring bg-surface-elevated text-fg placeholder:text-fg-soft" %>
      </div>
      <div class="mb-6">
        <%= f.label :contact_info, class: "block text-fg font-semibold mb-2" %>
        <%= f.text_field :contact_info, class: "w-full px-3 py-2 border border-border rounded focus:outline-none focus:ring-1 focus:ring-ring bg-surface-elevated text-fg placeholder:text-fg-soft" %>
      </div>
      <div>
        <%= f.submit "Atualizar Loja", class: "w-full bg-primary-400 text-white font-bold py-2 px-4 rounded hover:bg-secondary-400 transition" %>
      </div>
    <% end %>
    <div class="mt-4 text-center">
      <%= link_to "Voltar", store_path(@store), class: "text-accent-300 hover:underline" %>
    </div>
  </div>
</div>
